---
layout: base.njk
permalink: /site-map/
---
<h1>Site map</h1>

<p>The pages of this site, in the order of the main navigation and under the names it uses.</p>

<ol class="link-list site-map">
  {%- for item in site.nav %}
  <li><a href="{{ item.href }}">{{ item.label }}</a>
    {%- if item.href == "/reform-options/" %}
    {#- The section's first page is the link above, so the nest holds the other four. -#}
    <ul>
      {%- for entry in site.reformPages %}{% if not loop.first %}
      <li><a href="{{ entry.href }}">{{ entry.label }}</a></li>
      {%- endif %}{% endfor %}
    </ul>
    {%- elif item.href == "/tools/" %}
    <ul>
      {%- for path in ["/tools/triple-lock/", "/tools/compare/", "/tools/budget/", "/tools/history/"] %}
      <li><a href="{{ path }}">{{ path | pageName }}</a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </li>
  {%- endfor %}
</ol>

<h2 id="about">About this site</h2>
<ul class="link-list">
  {%- for entry in pages | where("group", "utility") %}
  <li><a href="{{ entry.path }}">{{ entry.title }}</a></li>
  {%- endfor %}
</ul>

<h2 id="sister-sites">Sister sites</h2>
<p>These are separate websites.</p>
<ul>
  {%- for sibling in site.siblings %}
  <li><a href="{{ sibling.url }}">{{ sibling.name }}</a>: {{ sibling.summary }}</li>
  {%- endfor %}
</ul>
