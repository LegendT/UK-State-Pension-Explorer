    {%- for id, model in [["care-cost-cap","A cap on lifetime care costs, set at " ~ ("care-cap-level" | fig)],["care-cost-free-personal","Free personal care for people aged 65 and over"],["care-cost-universal","Universal care, free when used"]] %}
