{
  "name": "uk-state-pension-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A plain-English explainer of the UK State Pension, the triple lock and reform options.",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
    "build": "rm -rf _site && eleventy && node scripts/check-build.mjs",
    "test": "node --test",
    "serve": "http-server _site -p 8137 -c-1 --silent",
    "a11y": "node scripts/a11y.mjs",
    "a11y:manual": "node scripts/a11y-manual-assist.mjs",
    "test:tools": "node scripts/check-tools.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "axe-core": "4.11.4",
    "http-server": "14.1.1",
    "puppeteer-core": "25.12.0"
  }
}
