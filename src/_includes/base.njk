{%- set entry = pages | where("path", page.url) | first -%}
{%- if not entry %}{{ ("No page register entry for " + page.url) | fail }}{% endif -%}
{%- set pageTitle = entry.title + " | " + site.name -%}
{%- set canonical = site.url + entry.canonical_path -%}
{%- set shareImage = site.url + "/assets/img/" + (entry.shareImage or "share-default") + ".png" -%}
<!doctype html>
<html lang="{{ site.language }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ entry.description }}">
{%- if not (site.indexable and entry.index) %}
<meta name="robots" content="noindex">
{%- endif %}
<link rel="canonical" href="{{ canonical }}">
<meta name="theme-color" content="#fdfdfc" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#15181a" media="(prefers-color-scheme: dark)">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_GB">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:title" content="{{ entry.shareTitle or entry.title }}">
<meta property="og:description" content="{{ entry.description }}">
<meta property="og:image" content="{{ shareImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ shareImages[entry.shareImage or 'share-default'] }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ entry.shareTitle or entry.title }}">
<meta name="twitter:description" content="{{ entry.description }}">
<meta name="twitter:image" content="{{ shareImage }}">
<meta name="twitter:image:alt" content="{{ shareImages[entry.shareImage or 'share-default'] }}">
<link rel="icon" href="/assets/img/favicon.svg" type="image/svg+xml">
<script src="/assets/js/js-class.js"></script>
{%- if site.analyticsToken %}
<script type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.analyticsToken }}"}'></script>
{%- endif %}
<link rel="stylesheet" href="/assets/css/main.css">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": "{{ site.url }}/#website",
      "url": "{{ site.url }}/",
      "name": {{ site.name | json | safe }},
      "inLanguage": "en-GB"{% if site.ownerName %},
      "publisher": { "@type": "{{ site.ownerType }}", "name": {{ site.ownerName | json | safe }} }{% endif %}
    },
    {
      "@type": "WebPage",
      "@id": "{{ canonical }}#webpage",
      "url": "{{ canonical }}",
      "name": {{ entry.title | json | safe }},
      "description": {{ entry.description | json | safe }},
      "isPartOf": { "@id": "{{ site.url }}/#website" },
      "inLanguage": "en-GB"{% if entry.published %},
      "datePublished": "{{ entry.published }}"{% endif %}{% if entry.modified %},
      "dateModified": "{{ entry.modified }}"{% endif %}
    }
  ]
}
</script>
</head>
<body>
<a class="skip-link" href="#main">Skip to main content</a>
{%- if not site.production %}
<div class="preview-banner" role="note">
  <div class="wrap">
    <p><strong>Preview for review.</strong> This site is not published. {% if site.reviewerName and site.reviewDate %}Its content was reviewed on {{ site.reviewDate | dateText }}, and its{% else %}A formal review of its content is not finished, and its{% endif %} accessibility assessment is not complete. <a href="/sources-and-method/#review-status">What has and has not been checked</a>.</p>
  </div>
</div>
{%- endif %}
<header class="site-header" id="top" tabindex="-1">
  <div class="wrap">
    <p class="brand"><a href="/">{{ site.name }}</a></p>
    <nav aria-label="Main">
      <details class="nav-menu">
        <summary>Menu</summary>
        <ul>
          {%- for item in site.nav %}
          <li><a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% elif item.href != "/" and page.url.startsWith(item.href) %} aria-current="true"{% endif %}>{{ item.label }}</a></li>
          {%- endfor %}
        </ul>
      </details>
    </nav>
  </div>
</header>
<main id="main" class="wrap" tabindex="-1">
{#- A reform page says where it sits in the series before its heading, as a multi-page guide on
    GOV.UK does (decision 121). -#}
{%- for item in site.reformPages %}{% if item.href == page.url %}
<p class="series-label">Reform options: page {{ loop.index }} of {{ loop.length }}</p>
{%- endif %}{% endfor %}
{{ content | safe }}
{%- set pager = page.url | pager %}
{%- if pager.previous or pager.next %}
<nav class="pager" aria-label="Next and previous pages">
  <ul>
    {%- if pager.previous %}
    <li class="previous"><a href="{{ pager.previous }}" rel="prev"><span>Previous</span> {{ pager.previous | pageName }}</a></li>
    {%- endif %}
    {%- if pager.next %}
    <li class="next"><a href="{{ pager.next }}" rel="next"><span>Next</span> {{ pager.next | pageName }}</a></li>
    {%- endif %}
  </ul>
</nav>
{%- endif %}
{%- if entry.modified %}
<p class="page-dates">Content of this page last changed on {{ entry.modified | dateText }}.{% if entry.figure_cards %} Each figure shows the date it was checked against its source under "More about this figure".{% endif %}</p>
{%- endif %}
{#- One link back up, in place of a link at the end of every section: decision 88. It goes to the
    start of the page, the site header with the menu, with the contents list below it on every page but
    the overview: decisions 94 and 131. back-to-top.js fixes it in the lower right of a long
    page and leaves no fragment in the address; without the script it stays here. -#}
<p class="back-to-top"><a href="#top">Back to top<span aria-hidden="true"> &uarr;</span></a></p>
<script type="module" src="/assets/js/back-to-top.js"></script>
<script type="module" src="/assets/js/scroll-cue.js"></script>
</main>
<footer class="site-footer">
  <div class="wrap">
    <nav aria-labelledby="other-explainers">
      <h2 id="other-explainers">Our other explainers</h2>
      <ul class="explainers">
        {%- for sibling in site.siblings %}
        <li><a href="{{ sibling.url }}">{{ sibling.name }}</a> <span>{{ sibling.summary }} This is a separate website.</span></li>
        {%- endfor %}
      </ul>
    </nav>
    <nav aria-label="Footer">
      <ul class="footer-links">
        {%- for item in [["/sources-and-method/", "Sources, method and corrections"], ["/accessibility/", "Accessibility statement"], ["/privacy/", "Privacy"], ["/site-map/", "Site map"]] %}
        <li><a href="{{ item[0] }}"{% if page.url == item[0] %} aria-current="page"{% endif %}>{{ item[1] }}</a></li>
        {%- endfor %}
      </ul>
    </nav>
    <p>{{ site.name }} is an educational project. It is not a government service and does not give financial advice.{% if entry.figure_cards %} Rates and rules change, so each figure shows its source, and the date it was checked under "More about this figure".{% endif %}</p>
    <p>Contains public sector information licensed under the <a href="https://www.nationalarchives.gov.uk/doc/open-government-licence/version/3/">Open Government Licence v3.0</a>.</p>
  </div>
</footer>
</body>
</html>
