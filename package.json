    "a11y:manual": "node scripts/a11y-manual-assist.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.6",
    "http-server": "14.1.1",
    "pa11y-ci": "4.1.1"
  }
}
