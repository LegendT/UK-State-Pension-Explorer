{#- Shared components. Every figure and citation comes from the registers in src/_data. -#}

{%- macro classLabel(key) -%}
{{ { "published-rate": "Published rate", "published-rule": "Published rule", "observed-statistic": "Observed statistic", "estimate": "Estimate", "forecast": "Forecast", "projection": "Projection", "derived-calculation": "Calculated by this site", "research-benchmark": "Research benchmark", "hypothetical": "Hypothetical" }[key] }}
{%- endmacro -%}

{#- The kind of figure as one sentence, with "can be revised" where the record says so, then the official
    status of its source as a second sentence where the source record has one (W19, from R3 of the
    readability review): accredited official statistics, official statistics that are not accredited,
    official statistics in development, or a suspended accreditation. -#}
{%- macro statusLabel(status) -%}
{{ { "accredited": "Accredited official statistics", "official": "Official statistics, not accredited", "in-development": "Official statistics in development", "suspended": "Its accreditation is suspended" }[status] }}
{%- endmacro -%}

{#- A figure this site calculated, or a research benchmark, carries no status: the status belongs to
    the statistics a source publishes, not to a sum made from them. -#}
{%- macro kindLine(classification, provisional, status) -%}
{{ classLabel(classification) }}{% if provisional %}, can be revised{% endif %}.{% if status and classification != "derived-calculation" and classification != "research-benchmark" %} {{ statusLabel(status) }}.{% endif %}
{%- endmacro -%}

{#- A citation after a sentence. The short form shows the publisher and keeps the title for screen readers, so the link still names its destination. The full form is for "More about this figure". -#}
{%- macro cite(s, full) -%}
<a class="cite" href="{{ s.url }}">{{ s.publisher }}{% if full %}, {{ s.title }}{% else %}<span class="visually-hidden">, {{ s.title }}</span>{% endif %}</a>{% if s.published_date %} ({{ s.published_date | monthOrDayText }}){% endif %}
{%- endmacro -%}

{#- One muted line under a figure's paragraph, or in its card: the kind and its source's status, the period, the range where
    the record has one (decision 95), the source with its date, then the key caveat, each a sentence,
    so no label runs into a value (decision 56 as amended by 92, in the style of decision 77). "More
    about this figure" holds the rest. Where a line above a group of figures has said some parts once
    (sharedNote), pass that group: those parts are left out, and a figure whose every part the group
    said gets no line of its own unless it has a range. -#}
{%- macro sourceNote(f, group) -%}
{%- set caveat = f | openCaveat -%}
{%- set g = group or {} -%}
{%- if f.range or not (g.kind and g.period and g.source and g.caveat) %}
<p class="source-line">{% if not g.kind %}{{ kindLine(f.classification, f.provisional, f.source.status) }} {% endif %}{% if not g.period %}{{ f.period_label }}. {% endif %}{% if f.range %}Range: {{ f.range }}. {% endif %}{% if not g.source %}Source: {{ cite(f.source) }}. {% endif %}{% if not g.caveat %}{{ caveat[0] }}{% endif %}</p>
{%- endif %}
<details class="source">
    <summary>More about this figure<span class="visually-hidden">: {{ f.label }}</span></summary>
    <dl>
      <dt>Place</dt> <dd>{{ f.geography }}</dd>
      {%- if g.caveat %}<dt>Limits</dt> <dd>{{ caveat[0] }}{% if caveat[1] %} {{ caveat[1] }}{% endif %}</dd>{% elif caveat[1] %}<dt>Other limits</dt> <dd>{{ caveat[1] }}</dd>{% endif %}
      <dt>Source</dt> <dd>{{ cite(f.source, true) }}. Checked against the source on {{ f.checked_date | dateText }}.</dd>
      <dt>What it measures</dt> <dd>{{ f.definition }}</dd>
      <dt>Who it covers</dt> <dd>{{ f.population }}</dd>
      <dt>Where in the source</dt> <dd>{{ f.table_reference }}</dd>
      {%- if f.passage %}<dt>What the source says</dt> <dd>"{{ f.passage }}"</dd>{% endif %}
      {%- if f.formula %}<dt>Calculation</dt> <dd>{{ f.formula }}</dd>{% endif %}
      {%- if f.gross_net %}<dt>Before or after tax</dt> <dd>{{ f.gross_net }}</dd>{% endif %}
      {%- if f.price_basis and f.price_basis != "not applicable" %}<dt>Price basis</dt> <dd>{{ f.price_basis | upperFirst }}</dd>{% endif %}
      {%- if f.source.note %}<dt>About the source</dt> <dd>{{ f.source.note }}</dd>{% endif %}
      {%- if f.next_review %}<dt>When we will check again</dt> <dd>{{ f.next_review }}</dd>{% endif %}
    </dl>
</details>
{%- endmacro -%}

{#- One line above a group of figures, saying once what every figure in it shares: the "shared"
    filter works that out from their records (R14 of the readability review). -#}
{%- macro sharedNote(g) -%}
<p class="source-line shared">The figures below: {% if g.kind %}{{ kindLine(g.kind.classification, g.kind.provisional, g.kind.status) }} {% endif %}{% if g.period %}{{ g.period }}. {% endif %}{% if g.source %}Source: {{ cite(g.source) }}. {% endif %}{% if g.caveat %}{{ g.caveat }}{% endif %}</p>
{%- endmacro -%}

{#- A figure shown as a card: label, value, plain meaning, source. -#}
{%- macro stat(f, what, level, group) -%}
<article class="stat">
  <h{{ level or 3 }} id="card-{{ f.id }}">{{ f.label }}</h{{ level or 3 }}>
  <p class="value">{{ f.shown }}</p>
  {%- if what %}<p class="what">{{ what }}</p>{% endif %}
  {{ sourceNote(f, group) }}
</article>
{%- endmacro -%}

{#- id: typed in the template, so the address of a note does not change with its words (W29). -#}
{%- macro note(heading, level, id) -%}
<div class="note" role="note">
  <h{{ level or 3 }}{% if id %} id="{{ id }}"{% endif %}>{{ heading }}</h{{ level or 3 }}>
  {{ caller() }}
</div>
{%- endmacro -%}

{%- macro unavailable(heading, level, id) -%}
<div class="unavailable" role="note">
  <h{{ level or 3 }}{% if id %} id="{{ id }}"{% endif %}>Not available: {{ heading }}</h{{ level or 3 }}>
  {{ caller() }}
</div>
{%- endmacro -%}

{#- The contents list. Each item is [id, label] or [id, label, [[id, label], ...]] for a section long
    enough to list its h3 headings: over about four phone screens (W7). On a reform page, pass true as
    well: the list then names the section's pages in order, with this page's sections nested under it,
    so the two lists a reader saw one after the other are one (note 4 of the page review). A reform
    page with no sections of its own, the calculator, keeps the list in the page's flow. -#}
{%- macro contents(items, section) -%}
<nav class="contents{% if section and not items.length %} section-nav{% endif %}" aria-labelledby="contents-heading">
  <h2 id="contents-heading">{% if section %}Reform options{% else %}On this page{% endif %}</h2>
  {%- if section %}
  <ol>
    {%- for item in site.reformPages %}
    <li><a href="{{ item.href }}"{% if page.url == item.href %} aria-current="page"{% endif %}>{{ item.label }}</a>
      {%- if page.url == item.href and items.length %}
      {{ sectionList(items) }}
      {%- endif %}
    </li>
    {%- endfor %}
  </ol>
  {%- else %}
  {{ sectionList(items) }}
  {%- endif %}
</nav>
<script type="module" src="/assets/js/contents.js"></script>
{%- endmacro -%}

{%- macro sectionList(items) -%}
<ul>
  {%- for item in items %}
  <li><a href="#{{ item[0] }}">{{ item[1] }}</a>
    {%- if item[2] %}
    <ul>
      {%- for sub in item[2] %}
      <li><a href="#{{ sub[0] }}">{{ sub[1] }}</a></li>
      {%- endfor %}
    </ul>
    {%- endif %}
  </li>
  {%- endfor %}
</ul>
{%- endmacro -%}

{#- A link to a sister site. The label names the destination site. -#}
{%- macro sisterLink(link) -%}
<a href="{{ link.url }}">{{ link.label }} ({{ link.site }})</a>
{%- endmacro -%}

{#- A scrolling wrapper for a table. It is named by the table's caption at build time: see "tableRegions" in eleventy.config.js. -#}
{%- macro scrollTable() -%}
<div class="scroll-x" tabindex="0" role="region">
{{ caller() }}
</div>
{%- endmacro -%}

{#- A source after a sentence, on a line of its own under it, small and muted: decision 77. -#}
{%- macro ref(s, label) -%}
<span class="ref">{{ label or "Source" }}: {{ cite(s) }}.</span>
{%- endmacro -%}

{#- A link onward from a short entry, on a line of its own, so it does not run into the source before it. -#}
{%- macro more(href, text) -%}
<span class="onward">More: <a href="{{ href }}">{{ text }}</a></span>
{%- endmacro -%}

{#- A citation for a claim in the claims register. -#}
{%- macro c(id) -%}
{%- set r = id | claim -%}
{% if r.source %}{{ ref(r.source) }}{% else %}<span class="ref">A record of a search: <a href="/sources-and-method/#claim-{{ id }}">what was searched, and when</a>.</span>{% endif %}
{%- endmacro -%}

{#- A figure in running text, with its period. The comment after it names the figure's source for the
    proseCitations transform, which checks the citation that follows and then removes the comment. A figure said again after its source,
    as in "above", uses the fig filter instead, which the check does not see. -#}
{%- macro f(id) -%}{{ id | fig }}<!--fig:{{ id }} {{ (id | figure).source.url }}-->{%- endmacro -%}

{#- One text input with its label, hint and error line. inputmode keeps a number keypad on phones. -#}
{%- macro field(id, label, value, hint, prefix, suffix, mode) -%}
<div class="field">
  <label for="{{ id }}">{{ label }}</label>
  {%- if hint %}<span class="hint" id="{{ id }}-hint">{{ hint }}</span>{% endif %}
  <span class="error" id="{{ id }}-error" role="alert"></span>
  <span class="affix">{% if prefix %}<span aria-hidden="true">{{ prefix }}</span>{% endif %}<input type="text" inputmode="{{ mode or 'decimal' }}" id="{{ id }}" name="{{ id }}" value="{{ value }}" autocomplete="off"{% if hint %} aria-describedby="{{ id }}-hint"{% endif %}>{% if suffix %}<span aria-hidden="true">{{ suffix }}</span>{% endif %}</span>
</div>
{%- endmacro -%}

{#- A table from src/_data/tables.json, with its source and qualifications. -#}
{%- macro dataTable(id, numeric) -%}
{%- set t = tables[id] -%}
{%- set s = (t.source_id | sourceRecord) if t.source_id else null -%}
<div class="scroll-x" tabindex="0" role="region" aria-labelledby="table-{{ id }}">
<table>
  <caption id="table-{{ id }}">{{ t.caption }}</caption>
  <thead><tr>{% for col in t.columns %}<th scope="col"{% if t.align[loop.index0] == "r" %} class="num"{% endif %}>{{ col }}</th>{% endfor %}</tr></thead>
  <tbody>
    {%- for row in t.rows %}
    <tr>{% for cell in row %}{% if loop.first %}<th scope="row">{{ cell }}</th>{% else %}<td{% if t.align[loop.index0] == "r" %} class="num"{% endif %}>{{ cell }}</td>{% endif %}{% endfor %}</tr>
    {%- endfor %}
  </tbody>
</table>
</div>
<div class="source">
  <p>{{ t.qualifications }}</p>
  <p>{% if s %}Source: {{ cite(s) }}. {% endif %}{{ t.table_reference }} Checked against the source on {{ t.checked_date | dateText }}.</p>
</div>
{%- endmacro -%}
