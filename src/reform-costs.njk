    {%- set fg = id | figure %}
    <tr><th scope="row" class="num phrase">{{ id | figShown }} a year</th><td>{{ against }}</td><td>{{ fg.period_label }}</td><td>{{ fg.gross_net }}</td><td>{{ m.cite(fg.source) }}</td></tr>
