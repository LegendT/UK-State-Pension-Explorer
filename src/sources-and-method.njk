  <dt>Changes in policy or rates</dt>
  <dd>{% if corrections.policy_changes | length %}<ul>{% for item in corrections.policy_changes %}<li>{{ item.date | timeTag | safe }}: {{ item.text }}</li>{% endfor %}</ul>{% else %}None recorded.{% endif %}</dd>
  <dt>Revisions by the producer of a statistic</dt>
  <dd>{% if corrections.statistical_revisions | length %}<ul>{% for item in corrections.statistical_revisions %}<li>{{ item.date | timeTag | safe }}: {{ item.text }}</li>{% endfor %}</ul>{% else %}None recorded.{% endif %}</dd>
</dl>

