{
  "name": "uk-state-pension-explorer",
  "version": "0.1.0",
  "private": true,
  "description": "A plain-English explainer of the UK State Pension, the triple lock and reform options. Working title.",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve",
